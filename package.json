{
  "name": "ledger",
  "private": true,
  "version": "0.1.0",
  "description": "What I owe and what I'm owed: a personal follow-up tracker. Local, OneDrive-backed, with an on-device AI model.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build && node scripts/build-standalone.mjs",
    "build:web": "tsc --noEmit -p tsconfig.json && vite build",
    "build:standalone": "node scripts/build-standalone.mjs",
    "serve": "node server/serve.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.0.0",
    "@kenjiuno/msgreader": "^1.29.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "buffer": "^6.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
